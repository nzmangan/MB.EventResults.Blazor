<h2>@TextService.PackEffect</h2>

@if (_Rows.Count == 0) {
  <p>@TextService.NoPackData</p>
} else {
  <div class="table-responsive">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>@TextService.Runner</th>
          <th>@TextService.Club</th>
          <th>@TextService.LegsNearOthers</th>
          <th>@TextService.LegsAlone</th>
          <th>@TextService.PaceNearOthers</th>
          <th>@TextService.PaceAlone</th>
          <th>@TextService.Difference</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var row in _Rows) {
          <tr>
            <td>@row.Name</td>
            <td>@row.Club</td>
            <td>@row.LegsNearOthers</td>
            <td>@row.LegsAlone</td>
            <td>@row.PaceNearOthers.Round("%")</td>
            <td>@row.PaceAlone.Round("%")</td>
            <td>@FormatDifference(row.PaceNearOthers - row.PaceAlone)</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
}
